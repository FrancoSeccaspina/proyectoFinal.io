# variables de entorno que se usan para la configuracion de docker-compose
# mysql
MYSQL_ROOT_PASSWORD=passRoot
DATABASE_NAME=gimnasio_activa
DATABASE_USER=gymuser
DATABASE_PASSWORD=passGymUser

# se usa el nombre del servicio de la db como host
DATABASE_HOST=activa-db

NODE_ENV = prod
REACT_APP_FRONTEND_DOMAIN_HOST=localhost:3000
REACT_APP_BACKEND_DOMAIN_HOST=localhost:3032