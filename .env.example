# ============================================================
# Variables de entorno — archivo único para todo el proyecto
# Copiar como .env y completar con los valores del equipo
# ============================================================

# --- MySQL (Docker Compose) ---
MYSQL_ROOT_PASSWORD=
DATABASE_NAME=gimnasio_activa
DATABASE_USER=
DATABASE_PASSWORD=

# --- Backend (Express) ---
DATABASE_HOST=localhost          # localhost (dev local) | activa-db (Docker)
PORT=3032
SESSION_PASSWORD=                # string largo aleatorio
JWT_SECRET=                      # string largo aleatorio
TIEMPO_CONTROL_STOCK_MINUTOS=30
NODE_ENV=development             # development | production

# --- URLs (CORS y redirecciones) ---
# Desarrollo local:
REACT_APP_BACKEND_DOMAIN_HOST=http://localhost:3032
REACT_APP_FRONTEND_DOMAIN_HOST=http://localhost:3000
# Producción:
# REACT_APP_BACKEND_DOMAIN_HOST=https://activafitness.com.ar
# REACT_APP_FRONTEND_DOMAIN_HOST=https://dashboard.activafitness.com.ar

# --- Frontend (React) ---
BROWSER=none
