<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./partials/head.ejs') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuestros Productos - [Nombre de tu Tienda]</title>
    <link rel="stylesheet" href="/css/productos.css">

</head>

<body>
<%- include('./partials/header.ejs') %>

<main class="main-content" aria-labelledby="products-main-heading">
    <h1 id="products-main-heading" class="visually-hidden">Listado de Nuestros Productos</h1>
    <div class="container-allMain">
    <ul role="list" aria-label="Lista de productos disponibles">
        <% productos.forEach(producto=> { %>
        <li class="product-item list-group-item p-3">
        <article aria-labelledby="product-name-<%= producto.id %>">
            <a href="/productos/<%= producto.id %>" aria-label="Ver detalles del producto <%= producto.nombre %>">
            <picture>
                <img src="../../images/<%= producto.imagen %>" alt="Imagen del producto <%= producto.nombre %>"
                class="img-juego" />
                </picture>
            <h2 id="product-name-<%= producto.id %>" class="visually-hidden"><%= producto.nombre %></h2>
            </a>

            <div class="informacion">
            <span class="tipo-envio" aria-label="Estado de stock: En stock">En stock</span>
            <div class="container-prices">
                <span class="precio-ahora" aria-label="Precio: $<%= (producto.precio - (producto.precio * 0.1)).toFixed(2) %>">
                  $<%=(producto.precio - (producto.precio * 0.1)).toFixed(2) %>
                </span>
                </div>
            <span class="tipo-entrega" aria-label="Tipo de entrega: Inmediata">Entrega inmediata</span>
            <h3 class="name-product" aria-hidden="true">
                <%= producto.nombre %>
            </h3>
            <input type="hidden" name="categoriaId" id="categoriaId" value="<%=producto.categoriaId%>">
            </div>
        </article>
        </li>
        <% }); %>
    </ul>
    </div>
</main>
</body>
<footer class="main-footer">
<%- include('./partials/footer.ejs') %>
</footer>
<script src="./js/filtroLupa.js"></script>
</html>