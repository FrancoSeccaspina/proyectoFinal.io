<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./partials/head.ejs') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuestros Productos - [Nombre de tu Tienda]</title>
    <link rel="stylesheet" href="/css/general.css">
    <link rel="stylesheet" href="/css/productos.css">
</head>

<body>
<%- include('./partials/header.ejs') %>

<main class="mainLienzo" aria-labelledby="products-main-heading">
    <h1 id="products-main-heading" class="visually-hidden">Listado de Nuestros Productos</h1>
    <div class="container-allMain">
    <ul class="moverlo" role="list" aria-label="Lista de productos disponibles">
        <% productos.forEach(producto => { %>
        <li class="card">
        <article aria-labelledby="product-name-<%= producto.id %>">
            <a href="/productos/<%= producto.id %>" aria-label="Ver detalles del producto <%= producto.nombre %>">
            <picture>
                <img src="../../images/<%= producto.imagen %>" alt="Imagen del producto <%= producto.nombre %>" class="card-img-top"/>
            </picture>
            <h2 id="product-name-<%= producto.id %>" class="visually-hidden"><%= producto.nombre %></h2>
            </a>

            <div class="card-body">
                <span class="tipo-envio">En stock</span>
                <div class="container-prices">
                    <span class="precio-ahora">
                      $<%=(producto.precio - (producto.precio * 0.1)).toFixed(2) %>
                    </span>
                </div>
                <span class="tipo-entrega">Entrega inmediata</span>
                <h3 class="card-title"><%= producto.nombre %></h3>
            </div>

            <div class="boton">
              <a href="/productos/<%= producto.id %>" class="btn-primary">Ver más</a>
            </div>
        </article>
        </li>
        <% }); %>
    </ul>
    </div>
</main>

<%- include('./partials/footer.ejs') %>
<script src="/js/filtroLupa.js"></script>
</body>
</html>