<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('./partials/head.ejs') %>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Cambiar Contraseña - Activa Fitness</title>
        <link rel="stylesheet" href="/css/update-password.css">
        <link rel="stylesheet" href="/css/button-form.css" />
</head>

<body class="body-style">
    <%- include('./partials/header.ejs') %>

        <section class="separador"></section>

        <main class="mainLienzo-update-password">
            <h2 id="h2-update-password">Cambiar Contraseña</h2>

            <div class="form-container">
                <div id="left-update-contrasenia" aria-labelledby="update-contrasenia-heading">
                    <form action="/users/change-password/<%= token %>" method="POST" class="form-container"
                        enctype="application/x-www-form-urlencoded" id="update-contrasenia-form"
                        aria-label="Formulario de cambio de contraseña">


                        <label for="contrasenia" class="visually-hidden">Contraseña</label>
                        <input type="password" name="contrasenia" id="contrasenia" class="inputs-register" required
                            aria-describedby="password-requirements error-contrasenia"
                            aria-invalid="<%= (locals && locals.errors && errors.contrasenia) ? 'true' : 'false' %>"
                            placeholder="Contraseña *" />
                        <% if (locals && locals.errors && errors.contrasenia) { %>
                        <p id="error-contrasenia" class="feedback" role="alert"><%= errors.contrasenia.msg %></p>
                        <% } %>

                        <label for="confirmar-contrasenia" class="visually-hidden">Confirmar Contraseña</label>
                        <input type="password" name="confirmar_contrasenia" placeholder="Confirmar Contraseña *"
                            id="confirmar-contrasenia" class="inputs-register" required
                            aria-describedby="error-confirmar-contrasenia"
                            aria-invalid="<%= (locals && locals.errors && errors.confirmar_contrasenia) ? 'true' : 'false' %>" />
                        <% if (locals && locals.errors && errors.confirmar_contrasenia) { %>
                        <p id="error-confirmar-contrasenia" class="feedback" role="alert"><%= errors.confirmar_contrasenia.msg %></p>
                        <% } %>

                        <div class="inputs-contra" id="password-requirements">
                            <p>La contraseña debe contener:</p>
                            <ul role="list">
                            <li>Al menos 8 caracteres</li>
                            <li>Una letra mayúscula</li>
                            <li>Un número</li>
                            <li>Un carácter especial (por ejemplo: @, #, $)</li>
                            </ul>
                        </div>

                        <button type="submit" class="button-access">
                            <span class="label">Registrarse</span>
                            <svg class="icon" xmlns="http://www.w3.org/2000/svg" fill="none" width="30" height="30" viewBox="0 0 24 24"
                            stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </main>

        <%- include('./partials/footer.ejs') %>
</body>


</html>