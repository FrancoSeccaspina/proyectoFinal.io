<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('./partials/head.ejs') %>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Cambiar Contraseña - Activa Fitness</title>
        <link rel="stylesheet" href="/css/update-password.css">
        <link rel="stylesheet" href="/css/button-form.css" />
</head>

<body>
    <%- include('./partials/header.ejs') %>

        <section class="separador"></section>

        <main class="mainLienzo-update-password">
            <h2 id="h2-update-password">Cambiar Contraseña</h2>

            <div class="form-container">
                <div id="left-update-contrasenia" aria-labelledby="update-contrasenia-heading">
                    <form action="/users/change-password/<%= id %>" method="POST" class="form-update-contrasenia"
                        enctype="multipart/form-data" id="update-contrasenia-form"
                        aria-label="Formulario de cambio de contraseña">
                        <input type="hidden" name="_method" value="PUT">
                        <label for="contrasenia-input">Nueva Contraseña</label>
                        <input class="inputs-update-contrasenia" type="password" name="contrasenia"
                            id="contrasenia-input" placeholder="Nueva Contraseña"
                            value="<%= typeof oldData !== 'undefined' && oldData.contrasenia ? oldData.contrasenia : '' %>"
                            autocomplete="new-password" required>
                        <% if(locals && locals.errors && errors.password) { %>
                            <p class="feedback" id="contrasenia" aria-live="polite">
                                <%= errors.contrasenia.msg %>
                            </p>
                            <% } %>
                                <button class="button-form" type="submit" id="update-password-button">Cambiar
                                    Contraseña</button>
                    </form>
                </div>
            </div>
        </main>

        <%- include('./partials/footer.ejs') %>
</body>


</html>