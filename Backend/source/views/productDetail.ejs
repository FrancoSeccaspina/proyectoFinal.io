<!DOCTYPE html>
<html lang="es">
<head>
<%- include('./partials/head.ejs') %>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Detalle del Producto: <%= producto.nombre %> - [Nombre de tu Tienda]</title>
<link rel="stylesheet" href="/css/productDetail.css" />

</head>

<body>
<%- include('./partials/header.ejs') %>

<main class="mainProductDetail">
    <% if (typeof message !=='undefined' && message) { %>
    <div class="alert alert-success" role="status" aria-live="polite">
    <p><%= message %></p>
    </div>
    <% } %>

    <div id="main-content">
    <section class="container-image" aria-labelledby="product-image-title">
        <h2 id="product-image-title" class="visually-hidden">Imágenes del producto <%= producto.nombre %></h2>
        <img src="/images/<%= producto.imagen %>" alt="Imagen de <%= producto.nombre %>" class="img-juego" />
        </section>

    <section class="main-description" aria-labelledby="product-details-heading">
        <h1 id="product-details-heading" class="visually-hidden">Detalles y compra de <%= producto.nombre %></h1>
        <section class="section-description" aria-labelledby="description-title">
        <h2 id="description-title">Descripción del producto: <%= producto.nombre %></h2>
        <p><%= producto.descripcion %></p>
        </section>

        <section class="list-products" aria-labelledby="features-title">
        <h2 id="features-title" class="visually-hidden">Características y beneficios</h2>
        <ul class="lista-description">
            <li>Paso a paso de cómo utilizar el producto</li>
            <li>Instructivo en español</li>
            <li>Buscar video de cómo ingerirlo de manera correcta</li>
            <li style="color: #bbbbbb; font-weight: bolder" aria-label="Información adicional: Entrega Inmediata">
            Entrega Inmediata
            </li>
        </ul>

        <div class="price-content">
            <div class="precios">
            <span class="precio-ahora" aria-label="Precio actual: $<%= producto.precio %>">
                $<%= (producto.precio) %>
            </span>
            </div>

            <form class="cantidadProductos" action="/carrito/agregar" method="POST" aria-label="Formulario para agregar producto al carrito">
            <span id="stock-info">Stock disponible: <%= producto.stock %></span>
            <input type="hidden" name="id_producto" value="<%= producto.id %>">

            <label for="cantidad-producto" class="visually-hidden">Cantidad a comprar</label>
            <input type="number" name="cantidad" id="cantidad-producto" min="1" max="<%= producto.stock %>" value="1" required aria-describedby="stock-info">
            <button type="submit" class="crear">
                Comprar
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                </button>
            </form>
        </div>
        </section>
    </section>
    </div>
</main>

<%- include('./partials/footer.ejs') %>
</body>

</html>