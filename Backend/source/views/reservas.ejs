<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./partials/head.ejs') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tus Reservas - Historial y Estado - [Nombre de tu Tienda]</title>
    <link rel="stylesheet" href="/css/register.css" />
    <link rel="stylesheet" href="/css/carrito.css">
    <link rel="stylesheet" href="/css/button-form.css">
    <link rel="stylesheet" href="/css/reservas.css">

</head>

<body>

<%- include('./partials/header.ejs') %>

    <main class="container-allMain-cart" aria-labelledby="main-heading-reservas">
    <h1 id="main-heading-reservas" class="visually-hidden">Tus Reservas Realizadas</h1>
    <section id="header-cart" aria-labelledby="reservas-section-title">
    <h2 id="reservas-section-title">Reservas</h2>
    <div id="warning-sentence" role="status" aria-live="polite">
        <img src="/images/exclamation.png" alt="Icono de información." aria-hidden="true">
        <p><strong>Verifica el estado de tu reserva.</strong></p>
    </div>

    <section class="contenedor-compras" aria-labelledby="detalle-reservas-heading">
        <h3 id="detalle-reservas-heading">Detalle de tus reservas</h3>
        <% if (reservas && reservas.length > 0) { %>
        <ul role="list" aria-label="Lista de tus reservas">
            <% reservas.forEach(function(reserva, reservaIndex) { %>
            <% if (reserva.detalleReserva && reserva.detalleReserva.length > 0) { %>
                <li class="compra-group">
                <h4 class="visually-hidden" id="reserva-<%= reserva.id_reserva %>-heading">Reserva con ID <%= reserva.id_reserva %></h4>
                <% if (reserva.estado && reserva.estado == 'pendiente') { %>
                    <form action="/reserva/eliminar/<%= reserva.id_reserva %>?_method=PATCH" method="POST"
                    aria-labelledby="cancel-reserva-<%= reserva.id_reserva %>-button">
                    <button type="submit" class="cart-remove-button btn-confirmar"
                        id="cancel-reserva-<%= reserva.id_reserva %>-button" title="Cancelar esta reserva">
                        <span class="visually-hidden">Cancelar Reserva con ID <%= reserva.id_reserva %></span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000"
                        viewBox="0 0 256 256" aria-hidden="true">
                        <path
                            d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z">
                        </path>
                        </svg>
                    </button>
                    </form>
                <% } %>

                <a href="/reserva/mostrar/reserva/<%= reserva.id_reserva ? reserva.id_reserva : '' %>"
                    class="button-link" aria-label="Ver detalles completos de la reserva ID <%= reserva.id_reserva %>">
                    Ver Detalles
                </a>
                <% if ( reserva.estado && reserva.estado == 'pendiente' ){ %>
                    <p><strong>La reserva vence en:</strong> <span class="cuenta-regresiva"
                        data-vencimiento="<%= reserva.vencimiento %>"></span></p>
                <% } %>

                <div class="compra-details">
                    <p><strong>Estado:</strong> <%= reserva.estado ? reserva.estado : 'No disponible' %></p>
                    <p><strong>Fecha de Reserva:</strong> <%= reserva.fecha ? (reserva.fecha.toLocaleString ? reserva.fecha.toLocaleString() : reserva.fecha) : 'No disponible' %></p>
                    <% reserva.detalleReserva.forEach(function(detalle, detalleIndex) { %>
                    <div class="compra-item">
                        <p><strong>Producto:</strong> <%= detalle.Producto ? detalle.Producto.nombre : 'No disponible' %></p>
                        <p><strong>Cantidad:</strong> <%= detalle.cantidad ? detalle.cantidad : 'No disponible' %></p>
                        <% if (detalle.Producto && detalle.Producto.precio) { %>
                        <p><strong>Precio Unitario:</strong> $<%= detalle.Producto.precio %></p>
                        <% } else { %>
                        <p><strong>Precio Unitario:</strong> No disponible</p>
                        <% } %>
                    </div>
                    <% }) %>
                </div>

                <div class="compra-total">
                    <p><strong>Total de la reserva:</strong> $<%= reserva.total ? reserva.total : 'No disponible' %></p>
                </div>
                </li>
            <% } %>
            <% }) %>
        </ul>
        <% } else { %>
        <div class="compra">
            <p>No hay reservas para mostrar.</p>
        </div>
        <% } %>
    </section>
    </section>

    <section id="payments" aria-labelledby="payment-methods-heading">
    <h2 id="payment-methods-heading">Elegí tu método de pago</h2>
    <div class="methods-img" role="group" aria-label="Opciones de pago disponibles">
        <a href="/transferencia" class="button-link">
        <button id="transferencia-btn">Transferencia Bancaria</button>
        </a>
        <a href="/mPago" class="button-link">
        <button id="mercadopago-btn">Mercado Pago</button>
        </a>
    </div>
    </section>
</main>

<%- include('./partials/footer.ejs') %>

<div>
    <%- include('./partials/modalConfirmacion.ejs', {
    modalTitle: '¿Cancelar reserva?',
    modalMessage: '¿Estás seguro de que deseas cancelar esta reserva?'
    }) %>
</div>

<script src="/js/carrito.js"></script>
<script src="/js/estadoProductos.js"></script>
</body>

</html>