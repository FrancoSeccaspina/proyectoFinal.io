<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('./partials/head.ejs') %>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Olvide mi contraseña</title>
        <link rel="stylesheet" href="/css/update-password.css" />
        <link rel="stylesheet" href="/css/button-form.css" />
</head>

<body>
    <%- include('./partials/header.ejs') %>
        <main>
            <h1>Olvidé mi contraseña</h1>
            <p>Por favor, ingresa tu correo electrónico para restablecer tu contraseña:</p>
            <form action="/users/update-password" method="POST" enctype="multipart/form-data" class="form-editar-perfil"
                aria-describedby="form-description">
                <imput type="email" name="email" id="email" placeholder="Correo Electrónico " required
                    autocomplete="email" aria-describedby="error-email"
                    aria-invalid="<%= (locals && locals.errors && errors.email) ? 'true' : 'false' %>" />
                <% if (locals && locals.errors && errors.email) { %>
                    <p id="error-email" class="feedback" role="alert">
                        <%= errors.email.msg %>
                    </p>
                    <% } %>
                        <button type="submit" class="btn-submit">Enviar</button>

            </form>
        </main>
        include('./partials/footer.ejs') %>
</body>

</html>