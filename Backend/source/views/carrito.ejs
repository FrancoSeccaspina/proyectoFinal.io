<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('./partials/head.ejs') %>
  <link rel="stylesheet" href="/css/carrito.css">
  <link rel="stylesheet" href="/css/button-form.css">
</head>

<body class="body-style">
  <%- include('./partials/header.ejs') %>

  <main class="mainCarrito" role="main">

    <!-- ENCABEZADO -->
    <div class="cart-header" aria-labelledby="cart-title">
      <div class="cart-header-top">
        <h2 id="cart-title" class="cart-title">
          Carrito
          <span class="cart-count">(<%= productosCarrito.resultados.cantidadDeProductos %> productos)</span>
        </h2>
        <svg class="cart-icon-svg" height="36" viewBox="0 0 30 30" width="36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="white" d="M10.5 17h14c.278 0 .5.223.5.5s-.222.5-.5.5h-14c-.276 0-.5-.223-.5-.5s.224-.5.5-.5zm-1-4h16c.278 0 .5.223.5.5s-.222.5-.5.5h-16c-.276 0-.5-.223-.5-.5s.224-.5.5-.5zm-9-8c-.653 0-.67 1 0 1h3.6c.078.346.64 2.81 1.312 5.736.717 3.126 1.452 7.32 1.606 7.893.132.494.255 1.055.62 1.544.362.488 1 .826 1.862.826h16c.86 0 1.5-.338 1.863-.826.364-.49.487-1.05.62-1.545.265-.993 1.62-6.944 1.89-7.952.152-.566.202-1.156.022-1.69-.18-.534-.72-.988-1.395-.988h-20c-.653 0-.66 1 0 1h20c.325 0 .366.07.447.31.08.238.076.674-.04 1.108-.267.992-1.62 6.945-1.89 7.953-.135.506-.262.945-.456 1.206-.194.262-.42.424-1.06.424h-16c-.64 0-.866-.162-1.06-.424-.195-.26-.322-.7-.458-1.205-.114-.426-.88-4.732-1.595-7.856-.717-3.125-1.4-6.125-1.4-6.125C4.938 5.16 4.735 5 4.5 5zm23 18c-1.373 0-2.5 1.125-2.5 2.5s1.127 2.5 2.5 2.5c1.376 0 2.5-1.125 2.5-2.5S24.877 23 23.5 23zm0 1c.836 0 1.5.666 1.5 1.5s-.664 1.5-1.5 1.5c-.833 0-1.5-.666-1.5-1.5s.667-1.5 1.5-1.5zm-12-1C10.128 23 9 24.125 9 25.5s1.127 2.5 2.5 2.5c1.376 0 2.5-1.125 2.5-2.5S12.877 23 11.5 23zm0 1c.836 0 1.5.666 1.5 1.5s-.664 1.5-1.5 1.5c-.833 0-1.5-.666-1.5-1.5s.667-1.5 1.5-1.5z"/>
        </svg>
      </div>

      <div class="cart-warning" role="alert">
        <img src="/images/exclamation.png" alt="" aria-hidden="true">
        <p>Agregar productos al carrito no garantiza su reserva. La compra se completa únicamente al finalizar el proceso de pago.</p>
      </div>

      <p class="cart-terms">
        Comprando en <strong>Activa Fitness</strong> — aceptás los
        <a href="/docs/TerminosYCondiciones.pdf" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>
      </p>
    </div>

    <!-- CONTENIDO -->
    <div class="cart-body">

      <% if (productosCarrito.productos.length === 0) { %>
        <div class="cart-empty" role="status" aria-live="polite">
          <p>No hay productos en el carrito.</p>
          <a href="/productos" class="btn-ir-tienda">Ver productos</a>
        </div>
      <% } else { %>

        <!-- LISTA DE PRODUCTOS -->
        <ul class="cart-product-list" role="list" aria-label="Productos en el carrito">
          <% productosCarrito.productos.forEach(function(producto) { %>
          <li class="cart-product-row" role="listitem" aria-label="<%= producto.nombre %>">
            <img src="/images/<%= producto.imagen %>" alt="<%= producto.nombre %>" class="cart-product-img" />

            <div class="cart-product-info">
              <h3 class="cart-product-name"><%= producto.nombre %></h3>
              <p class="cart-product-meta">
                Precio unit.: <strong>$<%= producto.precio %></strong>
                &nbsp;·&nbsp;
                Cant.: <strong><%= producto.cantidad %></strong>
              </p>
            </div>

            <div class="cart-product-subtotal">
              <span class="visually-hidden">Subtotal: </span>
              <strong>$<%= producto.subtotal %></strong>
            </div>

            <form action="/carrito/eliminar/<%= producto.id %>?_method=DELETE" method="POST">
              <button type="submit"
                class="cart-remove-button btn-confirmar"
                data-class="<%= producto.id %>"
                aria-label="Eliminar <%= producto.nombre %> del carrito">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 256 256" aria-hidden="true">
                  <path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"/>
                </svg>
              </button>
            </form>
          </li>
          <% }) %>
        </ul>

        <!-- TOTAL + RESERVAR -->
        <div class="cart-footer">
          <div class="cart-total" aria-label="Total del carrito">
            <span class="cart-total-label">Total</span>
            <span class="cart-total-amount">$ <%= productosCarrito.resultados.total %></span>
          </div>

          <form action="/reserva/mostrar/ultimaReserva" method="POST">
            <button type="submit" class="btn-reservar" aria-label="Confirmar y reservar productos del carrito">
              Reservar
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>
          </form>
        </div>

      <% } %>

    </div>

    <div>
      <%- include('./partials/modalConfirmacion.ejs', {
        modalTitle: '¿Eliminar producto?',
        modalMessage: '¿Estás seguro de que deseas eliminar este producto del carrito?'
      }) %>
    </div>
  </main>

  <%- include('./partials/modalReserva.ejs') %>
  <%- include('./partials/footer.ejs') %>
  <script src="/js/carrito.js"></script>
</body>

</html>
