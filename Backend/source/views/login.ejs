<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('./partials/head.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión - Activa Fitness</title>
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/button-form.css" />
</head>

<body>
  <%- include('./partials/header.ejs') %>

  <section class="separador"></section> <!-- Franja blanca arriba -->

  <main class="mainLienzo-register">
    <h2 id="h2-login">Iniciar Sesión</h2>

    <div class="form-container">
      <div id="left-login" aria-labelledby="login-heading">
        <form action="/users/login" method="POST" aria-label="Formulario de inicio de sesión">
          <label for="email-input">Correo electrónico</label>
          <input class="inputs-login" type="email" name="email" id="email-input" placeholder="ejemplo@correo.com" value="<%= typeof oldData !== 'undefined' && oldData.email ? oldData.email : '' %>" autocomplete="username" required>
          <% if(locals && locals.errors && errors.email) { %>
          <p class="feedback" id="email-error" aria-live="polite"><%= errors.email.msg %></p>
          <% } %>

          <label for="password-input">Contraseña</label>
          <input class="inputs-login" type="password" name="contrasenia" placeholder="Contraseña" id="password-input" value="" autocomplete="current-password" required>
          <% if(locals && locals.errors && errors.contrasenia) { %>
          <p class="feedback" id="password-error" aria-live="polite"><%= errors.contrasenia.msg %></p>
          <% } %>

          <div id="recordame-me">
            <input type="checkbox" name="recordame" id="recordame" class="radio-options" value="recordame">
            <label for="recordame">Recordarme</label>
          </div>

          <button class="button-access" type="submit">Ingresar</button>
        </form>

        <!-- Botón para abrir el modal de recuperación -->
        <p style="text-align:center; margin-top: 1rem;">
          <button type="button" class="btn btn-abrir-modal-olvidaste" style="background:none; color:white; text-decoration:underline; border:none; cursor:pointer;">
            ¿Olvidaste tu contraseña?
          </button>
        </p>
      </div>

      <div id="registrate" role="region" aria-label="Opciones de registro">
        <a href="/register">
          <i class="fa-regular fa-circle-user" aria-hidden="true"></i>
          Regístrate
        </a>
      </div>

      <picture id="right-login">
        <img src="../images/banner-jp.jpg" alt="Persona ejercitándose en un gimnasio, como banner de inicio de sesión." id="image-login">
      </picture>
    </div>
  </main>

  <section class="separador"></section> <!-- Franja blanca abajo -->
  <%- include('./partials/footer.ejs') %>

  <!-- Modal incluido al final del body -->
  <%- include('./partials/modalOlvidaste.ejs', {
    modalTitle: '¿Olvidaste tu contraseña?',
    modalMessage: 'Ingresá tu correo electrónico y te enviaremos un enlace para restablecerla.',
    modalAction: '/users/update-password'
  }) %>

  <%- include('./partials/modalConfirmacion.ejs', {
    modalTitle: '¿Eliminar producto?',
    modalMessage: '¿Estás seguro de que deseas eliminar este producto del carrito?'
  }) %>

  <%- include('./partials/modalMensaje.ejs', { mostrarModal, modalTitle, modalMessage }) %>

  <script src="https://unpkg.com/validator@latest/validator.min.js"></script>
  <script src="../js/login.js"></script>
</body>
</html>
