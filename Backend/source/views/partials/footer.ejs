
  <style>
.flotante {
    display: flex;
    position: fixed;
    color: white;    
    font-size: 14px;

    bottom: 0px;
    left: 0px;
    right: 0px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    background-color: #2e2e2e;
    justify-content: space-between;
}

@media (prefers-color-scheme: dark) {
  :root {
    --border-color: #4b5563;   /* gray-600 */
    --bg-color: #1f2937;       /* gray-800 */
    --text-color: #e5e7eb;     /* gray-200 */
    --link-bg-color: #374151;  /* gray-700 */
    --hover-color: #ffffff;
  }
}


.breadcrumb {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 14px;
  color: var(--text-color);
  list-style: none;
  padding: 0;
  padding-right: 2rem;
  margin: 0;
}


.breadcrumb-item {
  display: flex;
  align-items: center;

}

.breadcrumb-link {
  text-decoration: none;
  color: white;
  transition: color 0.2s;
  display: block;
}


.breadcrumb-link:hover {
  color: blue;
}


.breadcrumb-separator {
  display: flex;
  align-items: center;
}

.breadcrumb-icon {
  width: 16px;
  height: 16px;
}

html[dir="rtl"] .breadcrumb-icon {
  transform: rotate(180deg);
}

</style>
