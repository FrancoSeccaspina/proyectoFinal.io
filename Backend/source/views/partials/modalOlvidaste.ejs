<style>
  .modal-olvidaste {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 1rem;
    display: none;
  }

  .modal-content {
    overflow: hidden;
    max-width: 28rem;
    background-color: #000;
    padding: 1.5rem;
    border-radius: 0.5rem;
    border-top: 5px solid #d8331d;
    border-bottom: 5px solid #d8331d;
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }

  .modal-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: white;
  }

  .modal-body {
    margin-top: 1rem;
    color: white;
    font-size: 1rem;
  }

  .modal-footer {
    margin-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-cerrar {
    background-color: #2d3748;
    color: #e2e8f0;
  }

  .btn-cerrar:hover {
    background-color: #4a5568;
  }

  .btn-enviar {
    background-color: #d8331d;
    color: white;
  }

  .btn-enviar:hover {
    background-color: #d8331d;
  }

  .modal-form input {
    width: 100%;
    height: 3rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
    border: none;
    font-size: 1rem;
  }
</style>

<div class="modal-olvidaste" role="dialog" aria-modal="true" aria-labelledby="modalOlvidasteTitle">
  <div class="modal-content">
    <h2 id="modalOlvidasteTitle" class="modal-title"><%= modalTitle %></h2>

    <form action="<%= modalAction %>" method="POST" class="modal-form">
      <div class="modal-body">
        <p><%= modalMessage %></p>
        <input type="email" name="email" required placeholder="Tu correo electrónico" />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-cerrar">Cancelar</button>
        <button type="submit" class="btn btn-enviar">Enviar</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const abrirModal = document.querySelector('.btn-abrir-modal-olvidaste');
    const modal = document.querySelector('.modal-olvidaste');
    const cerrar = document.querySelector('.btn-cerrar');

    if (abrirModal && modal && cerrar) {
      abrirModal.addEventListener('click', function (e) {
        e.preventDefault();
        modal.style.display = 'grid';
      });

      cerrar.addEventListener('click', function () {
        modal.style.display = 'none';
      });
    }
  });
</script>
