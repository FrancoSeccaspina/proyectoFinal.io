<style>
  .nav-links {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    width: 100%;
  }

  .item-nav {
    color: #fff;
    transition: color 0.2s;
  }

  .item-nav:hover {
    color: red;
  }

.icon-nav {
  width: 6vw;
  max-width: 32px;
  min-width: 24px;
  aspect-ratio: 1 / 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}

.icon-nav i {
  font-size: 100%;
}

</style>

<header role="banner">
  <div id="header-container">

    <div id="top-bar">

      <!-- logo redireccion a home -->
      <div id="logo-container">
        <a href="/" aria-label="Volver a la página de inicio de ActivaFitness">
          <img src="/images/logo.png" alt="Logo Activa Fitness" id="logo-img">
        </a>
      </div>

      <div class="nav-container">

      <!-- Home -->
      <a class="item-nav" href="/" title="Inicio" aria-label="Ir a la página de Inicio">
        <div class="icon-nav">
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 10L12 2L21 10V20C21 20.55 20.55 21 20 21H16C15.45 21 15 20.55 15 20V16C15 15.45 14.55 15 14 15H10C9.45 15 9 15.45 9 16V20C9 20.55 8.55 21 8 21H4C3.45 21 3 20.55 3 20V10Z"/>
          </svg>
        </div>
      </a>


      <!-- Carrito -->
      <a class="item-nav" href="/carrito/mostrar" title="Carrito de Compras" aria-label="Ir al Carrito de Compras">
        <div class="icon-nav">
          <svg fill="currentColor" viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M10.5 17h14c.278 0 .5.223.5.5s-.222.5-.5.5h-14c-.276 0-.5-.223-.5-.5s.224-.5.5-.5zm-1-4h16c.278 0 .5.223.5.5s-.222.5-.5.5h-16c-.276 0-.5-.223-.5-.5s.224-.5.5-.5zm-9-8c-.653 0-.67 1 0 1h3.6c.078.346.64 2.81 1.312 5.736.717 3.126 1.452 7.32 1.606 7.893.132.494.255 1.055.62 1.544.362.488 1 .826 1.862.826h16c.86 0 1.5-.338 1.863-.826.364-.49.487-1.05.62-1.545.265-.993 1.62-6.944 1.89-7.952.152-.566.202-1.156.022-1.69-.18-.534-.72-.988-1.395-.988h-20c-.653 0-.66 1 0 1h20c.325 0 .366.07.447.31.08.238.076.674-.04 1.108-.267.992-1.62 6.945-1.89 7.953-.135.506-.262.945-.456 1.206-.194.262-.42.424-1.06.424h-16c-.64 0-.866-.162-1.06-.424-.195-.26-.322-.7-.458-1.205-.114-.426-.88-4.732-1.595-7.856-.717-3.125-1.4-6.125-1.4-6.125C4.938 5.16 4.735 5 4.5 5zm23 18c-1.373 0-2.5 1.125-2.5 2.5s1.127 2.5 2.5 2.5c1.376 0 2.5-1.125 2.5-2.5S24.877 23 23.5 23zm0 1c.836 0 1.5.666 1.5 1.5s-.664 1.5-1.5 1.5c-.833 0-1.5-.666-1.5-1.5s.667-1.5 1.5-1.5zm-12-1C10.128 23 9 24.125 9 25.5s1.127 2.5 2.5 2.5c1.376 0 2.5-1.125 2.5-2.5S12.877 23 11.5 23zm0 1c.836 0 1.5.666 1.5 1.5s-.664 1.5-1.5 1.5c-.833 0-1.5-.666-1.5-1.5s.667-1.5 1.5-1.5z" />
          </svg>
        </div>
      </a>

      <% if (!usuarioLogueado) { %>
        <!-- Registro -->
        <a class="item-nav" href="/register" title="Registrar usuario" aria-label="Registrar nuevo usuario">
          <div class="icon-nav">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path fill-rule="evenodd" clip-rule="evenodd"
                d="M13.3249 15.0763C12.8883 15.0257 12.4456 15 12 15C10.0188 15 8.09292 15.5085 6.52112 16.4465C5.30069 17.1749 4.34666 18.1307 3.74108 19.2183C3.46638 19.7117 3.79562 20.2902 4.34843 20.4054C7.85678 21.1365 11.4437 21.3594 15 21.074V21H14C12.3431 21 11 19.6569 11 18C11 16.5753 11.9932 15.3825 13.3249 15.0763Z"
                fill="currentColor" />
              <path d="M18 14L18 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <path d="M22 18L14 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <circle cx="12" cy="8" r="5" fill="currentColor" />
            </svg>
          </div>
        </a>

        <!-- Login -->
        <a class="item-nav" href="/login" title="Iniciar Sesión" aria-label="Iniciar sesión en tu cuenta">
          <div class="icon-nav">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M4 21c0-3.866 4.03-7 8-7s8 3.134 8 7v1H4v-1z" />
              <circle cx="12" cy="8" r="5" fill="currentColor" />
            </svg>
          </div>
        </a>
      <% } %>

      <% if (usuarioLogueado && usuarioLogueado.rol != "admin") { %>
        <!-- Perfil -->
        <a class="item-nav" href="/perfil" title="Perfil de usuario" aria-label="Ir a Perfil de usuario">
          <div class="icon-nav">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23857 2 7 4.23858 7 7C7 9.76142 9.23857 12 12 12Z" fill="currentColor"/>
              <path d="M4 20C4 16.6863 7.58172 14 12 14C16.4183 14 20 16.6863 20 20H4Z" fill="currentColor"/>
              <circle cx="20" cy="4" r="2" fill="currentColor"/>
            </svg>
          </div>
        </a>
      <% } %>

      <% if (usuarioLogueado) { %>
        <!-- Logout -->
        <a class="item-nav" href="/users/logout" title="Cerrar Sesión" aria-label="Cerrar sesión de usuario">
          <div class="icon-nav">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M10 12H20M20 12L17 9M20 12L17 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 12C4 7.58172 7.58172 4 12 4M12 20C9.47362 20 7.22075 18.8289 5.75463 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
        </a>
      <% } %>

      </div>
    </div>

    <nav id="main-nav" aria-label="Navegación principal del sitio">
      <ul class="nav-links">
        <li class="nav-item">
          <a href="/rutinas" aria-label="Ir a Rutinas de Ejercicio">
            <i class="fa-solid fa-dumbbell" aria-hidden="true"></i>
            <span>Rutinas</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/recetas" aria-label="Ir a Plan Alimenticio">
            <i class="fa-solid fa-utensils" aria-hidden="true"></i>
            <span>Plan Alimenticio</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/productos" aria-label="Ir a Productos de la Tienda">
            <i class="fa-solid fa-store" aria-hidden="true"></i>
            <span>Productos</span>
          </a>
        </li>

        <% if (usuarioLogueado) { %>
          <li class="nav-item">
            <a href="/reserva/mostrar/reservas" aria-label="Ver mis Reservas">
              <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
              <span>Reservas</span>
            </a>
          </li>
        <% }%>

        <li class="nav-item search-wrapper">
          <div class="search-box" role="search">
            <label for="search-input" class="visually-hidden">Buscar en el sitio</label>
            <input type="text" placeholder="Buscar" id="search-input">
            <i class="fas fa-search search-icon" aria-hidden="true"></i>
            </div>
        </li>
      </ul>
    </nav>

  </div>
</header>