<%
    const telefono = `549${numeroContacto}`;
    const link = `https://${backAppDomainHost}/Reserva/${reservaId}`;
    const mensaje = `Hola, quiero concretar la reserva: ${link}`;
    const mensajeCodificado = encodeURIComponent(mensaje);

    const whatsappURL = `https://wa.me/${telefono}?text=${mensajeCodificado}`;
    const whatsappURLParaQR = encodeURIComponent(whatsappURL);
%>



<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Confirmación de Reserva</title>
  <link rel="stylesheet" href="/css/transferencia.css">
</head>

<body class="body-transferencia">
  <main class="main-transferencia">
    <div class="pago-container" aria-labelledby="confirmacion-heading">
      <h2 id="confirmacion-heading">Reserva realizada con éxito</h2>

      <img src="https://api.qrserver.com/v1/create-qr-code/?data=<%= whatsappURLParaQR %>&size=200x200" alt="Código QR para WhatsApp" />


      <p>Gracias por tu reserva. Para finalizar el proceso de compra, necesitás comunicarte directamente con el gimnasio.</p>

      <div class="contacto-info">
        <p><strong>Teléfono / WhatsApp:</strong> <a href="<%= whatsappURL %>" target="_blank" rel="noopener noreferrer">
            <%= telefono %>
          </a></p>

        <p><strong>Horario de atención:</strong> Lunes a Viernes de 9:00 a 18:00 hs</p>
        <p><strong>Importante:</strong> La reserva quedará pendiente hasta que se confirme el pago con el dueño del gimnasio.</p>
      </div>

      <a href="/" class="volver-link">Volver al inicio</a>
    </div>
  </main>
</body>

</html>