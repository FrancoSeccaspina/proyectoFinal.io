<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('./partials/head.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorías de Recetas Saludables - [Nombre de tu Tienda]</title>
  <link rel="stylesheet" href="/css/general.css">
  <link rel="stylesheet" href="/css/recetas.css">
</head>

<body>
  <%- include('./partials/header.ejs') %>

  <main class="main-content" aria-labelledby="main-heading-recetas">
    <h1 id="main-heading-recetas" class="visually-hidden">Explorar Nuestras Categorías de Recetas Saludables</h1>

    <section class="titulo" aria-labelledby="section-title-recetas">
      <h3 id="section-title-recetas">Recetas</h3>
      <p>Ideas para cocinar</p>
      <p>Te brindamos algunas recetas útiles para tu alimentación.</p>

        <ul class="moverlo" role="list" aria-label="Categorías de recetas">
          <% const recetas = [
            { id: 1, titulo: 'Ganancia de Masa', img: 'masaMusculas.jpg' },
            { id: 2, titulo: 'Veganas', img: 'veganos.jpg' },
            { id: 3, titulo: 'Pérdida de Peso', img: 'perdidaPeso.jpg' },
            { id: 4, titulo: 'Definición', img: 'definicion.jpg' },
            { id: 5, titulo: 'Sin Gluten', img: 'sinGluten.jpg' },
            { id: 6, titulo: 'Rápidas y Fáciles', img: 'comidaRapida.jpg' },
          ]; %>
          <% recetas.forEach(r => { %>
            <li class="card">
              <article aria-labelledby="receta-<%= r.id %>">
                <h4 class="card-title" id="receta-<%= r.id %>"><%= r.titulo %></h4>
                <div class="card-body">
                  <a href="/recetas/categoria/<%= r.id %>" aria-label="Ver recetas para <%= r.titulo %>">
                    <img src="/images/<%= r.img %>" class="card-img-top" alt="Imagen representativa de <%= r.titulo %>.">
                  </a>
                  <a href="/recetas/categoria/<%= r.id %>" class="btn-primary">Ver Recetas</a>
                </div>
              </article>
            </li>
          <% }) %>
        </ul>

      <div class="consultar">
        <a href="https://api.whatsapp.com/send?phone=5491166601356" target="_blank" rel="noopener noreferrer">
          Consultar a tu asesor
        </a>
      </div>
    </section>
  </div>
</main>

  <%- include('./partials/footer.ejs') %>
</body>
</html>
