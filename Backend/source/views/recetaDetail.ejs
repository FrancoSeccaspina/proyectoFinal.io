<!DOCTYPE html>
<html lang="es">
  <head>
  <%- include('./partials/head.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nuestras Recetas Saludables - [Nombre de tu Tienda]</title>
  <link rel="stylesheet" href="/css/recetaDetail.css">
  <link rel="stylesheet" href="/css/footer.css">

</head>

<body class="body-style">
  <%- include('./partials/header.ejs') %>

<main class="mainRecetaDetail" aria-labelledby="main-heading-recetas">
  <h1 id="main-heading-recetas" class="visually-hidden">Recetas Saludables</h1>
  <div class="accordion-container" role="list" aria-label="Lista de recetas saludables">
    <% recetas.forEach((receta, index) => { %>
    <div class="accordion-card">
      <h2 class="accordion-header">
        <button class="accordion-toggle" aria-expanded="false" aria-controls="accordion-content-<%= index %>"
        id="accordion-button-<%= index %>">
        <%= receta.nombre.toUpperCase() %>
        <span class="arrow" aria-hidden="true">&#9660;</span>
        </button>

      </h2>
      <div class="accordion-content" id="accordion-content-<%= index %>" role="region"
        aria-labelledby="accordion-button-<%= index %>" hidden>
        <p><%= receta.descripcion %></p>
      </div>
    </div>
    <% }); %>
  </div>
</main>


    <%- include('./partials/footer.ejs') %>
    <script src="/js/accordion.js"></script>

  <!--<script>
    // Función JavaScript para manejar el acordeón y actualizar atributos ARIA.
