<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('./partials/head.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Perfil</title>
  <link rel="stylesheet" href="/css/perfil.css" />
</head>
<style>

</style>

<body>
  <%- include('./partials/header.ejs') %>

  <main class="mainLienzo" aria-labelledby="profile-main-title">
    <div class="profile-card" aria-labelledby="user-info-heading">

      <% if (usuarioLogueado) { %>

        <div class="avatar-container">
          <div style="position: relative;">
            <img class="avatar-bordered" src="/images/avatars/<%= usuarioLogueado.imagen %>" alt="Bordered avatar">
          </div>
        </div>

        <div class="profile-data">
          <h1 class="profile-title">Perfil del Usuario</h1>

          <div class="profile-info">
            <div class="info-row">
              <span class="label">Nombre completo:</span>
              <span class="value"><%= usuarioLogueado.nombre %> <%= usuarioLogueado.apellido %></span>
            </div>

            <div class="info-row">
              <span class="label">Celular:</span>
              <span class="value"><%= usuarioLogueado.celular %></span>
            </div>

            <div class="info-row">
              <span class="label">Fecha de nacimiento:</span>
              <span class="value"><%= usuarioLogueado.fecha_nacimiento %></span>
            </div>

            <div class="info-row">
              <% if (usuarioLogueado.fecha_fin_cuota) { %>
              <span class="label">Vigente hasta:</span>
              <span class="value"><%= usuarioLogueado.fecha_fin_cuota %></span>
              <% } else { %>
              <span class="value">Sin fecha de vencimiento de cuota registrada.</span>
              <% } %>
            </div>
          </div>
        </div>


        <div class="apto-medico">
          <h3 class="section-title">Información del Apto Medico</h3>

          <% if (usuarioLogueado.aptoMedico) { %>
          <p class="info-text">Apto médico cargado:</p>

          <% if (usuarioLogueado.aptoMedico.endsWith('.pdf')) { %>

          <a class="apto-link" href="/uploads/aptoMedico/<%= usuarioLogueado.aptoMedico %>" target="_blank" rel="noopener noreferrer" aria-label="Ver Apto Médico en formato PDF, se abre en una nueva pestaña">
            📄 Ver Apto Médico (PDF)
          </a>

          <% } else { %>

          <a class="apto-link" href="/uploads/aptoMedico/<%= usuarioLogueado.aptoMedico %>" target="_blank" rel="noopener noreferrer" aria-label="Ver imagen del Apto Médico, se abre en una nueva pestaña">

            <img class="apto-img" src="/uploads/aptoMedico/<%= usuarioLogueado.aptoMedico %>" alt="Imagen de apto médico del usuario" />

          </a>

          <% } %>

          <% } else { %>
          <p class="info-text">No se ha cargado un apto medico.</p>
          <% } %>
        </div>

      <% } %>
      
      <div class="display-flex-justify-center">
        <a href="/perfil/editar" class="button-access as-button">Editar mi perfil</a>
      </div>

    </div>
  </main>

  <%- include('./partials/footer.ejs') %>
</body>

</html>