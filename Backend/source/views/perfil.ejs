<!DOCTYPE html>
<html lang="es">
  <head>
  <%- include('./partials/head.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Perfil</title>
  <link rel="stylesheet" href="/css/perfil.css" />
</head>
<style>
.avatar-bordered {
  width: 15rem;
  height: 15rem;
  padding: 4px;
  border-radius: 9999px;
  border: 3px solid #6b7280; /* ring-2 ring-gray-300 */
}

.avatar-container{
    display: flex;
    align-items: center;
    flex-direction: column;
}

</style>

<body>
  <%- include('./partials/header.ejs') %>

  <main aria-labelledby="profile-main-title">
    <h1 id="profile-main-title">Mi Perfil</h1>

    <div class="main-profile">
      <% if (usuarioLogueado) { %>
        <section class="user-details-section" aria-labelledby="user-info-heading">
          <div class="avatar-container">
            <div style="position: relative;">
              <img class="avatar-bordered" src="/images/avatars/<%= usuarioLogueado.imagen %>" alt="Bordered avatar">
            </div>
          </div>

          <p><strong>Nombre completo:</strong> <%= usuarioLogueado.nombre %> <%= usuarioLogueado.apellido %></p>
          <p><strong>Celular:</strong> <%= usuarioLogueado.celular %></p>
          <p><strong>Fecha de nacimiento:</strong> <%= usuarioLogueado.fecha_nacimiento %></p>
          <p><strong>Estado de la Membresía:</strong> <%= usuarioLogueado.estado_membresia %></p>
  
          <% if (usuarioLogueado.fecha_fin_cuota) { %>
            <p><strong>Vigente hasta:</strong> <%= usuarioLogueado.fecha_fin_cuota %></p>
          <% } else { %>
            <p>Sin fecha de vencimiento de cuota registrada.</p>
          <% } %>
  
        </section>
      <% } %>
    </div>


    <nav aria-label="Opciones principales del perfil">
      <ul class="botones">
        <li><a href="/perfil/editar" class="crear-editar">Editar mi perfil</a></li>
        <li><a href="/" class="crear-editar">Volver a la página principal</a></li>
        </ul>
    </nav>

  </main>

  <%- include('./partials/footer.ejs') %>
</body>

</html>